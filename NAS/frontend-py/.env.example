# Vaultix NAS — Python frontend config
# Copy to .env and adjust for the Pi.

# Where the existing Node backend listens (same Pi, localhost)
NODE_API=http://127.0.0.1:3000

# Browser-facing URL for the Node backend (downloads, WebDAV open-in-Office
# links). Must be reachable from the USER'S machine, not just the Pi —
# NODE_API above is localhost and only works for server-to-server calls.
NODE_PUBLIC_URL=https://raspberrypi.tail8767da.ts.net

# Port this Python frontend serves on
FRONTEND_PORT=8001

# Set true when served over HTTPS (Tailscale Funnel). Locally over http, set false.
COOKIE_SECURE=true

# JWT cookie lifetime (days) — should match backend JWT_EXPIRES
JWT_DAYS=7

# ── 2FA (pwd_2FA_check) ──────────────────────────────────
# RP_ID = domain WITHOUT scheme/port; TFA_ORIGIN = full origin the browser sees.
# These MUST match how you serve the app, or WebAuthn (fingerprint/Hello) will fail.
RP_ID=raspberrypi.tail8767da.ts.net
TFA_ORIGIN=https://raspberrypi.tail8767da.ts.net:8444
TFA_DB=2fa.db
# Fernet key for encrypting TOTP secrets at rest. Leave blank to auto-generate a
# 2fa.db.key file (chmod 600). To set explicitly: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TFA_KEY=
